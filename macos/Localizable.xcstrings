    "Vary the concavity smoothly between light and shadow.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vary the concavity smoothly between light and shadow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varía la concavidad suavemente entre luz y sombra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites varier doucement la concavité entre lumière et ombre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verändere die Wölbung sanft zwischen Licht und Schatten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Varia dolcemente la concavità tra luce e ombra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Varie suavemente a concavidade entre luz e sombra."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Varia la concavitat suaument entre llum i ombra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de insnoering soepel veranderen tussen licht en schaduw."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавно меняйте вогнутость между светом и тенью."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавно змінюйте увігнутість між світлом і тінню."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光と影に合わせて、くぼみを滑らかに変化させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛과 그림자 사이에서 오목함을 부드럽게 바꿉니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在明暗之间平滑改变凹度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在明暗之間平滑改變凹度。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر التقعر بسلاسة بين الضوء والظل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי חלק של הקעירות בין אור לצל."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płynnie zmieniaj wklęsłość między światłem a cieniem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçbükeyliği ışık ve gölge arasında yumuşakça değiştirin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra konkaviteten mjukt mellan ljus och skugga."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोशनी और छाया के बीच अवतलता सहजता से बदलें।"
          }
        }
      }
    },
