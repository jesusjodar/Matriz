    "Music and artwork are available only in the desktop app; the screensaver keeps your chosen palette.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Music and artwork are available only in the desktop app; the screensaver keeps your chosen palette."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La música y las portadas solo están disponibles en la app de escritorio; el salvapantallas conserva tu paleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Musique et pochettes sont réservées à l’app de bureau ; l’économiseur conserve votre palette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik und Cover sind nur in der Schreibtisch-App verfügbar; der Bildschirmschoner behält deine Palette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Musica e copertine sono disponibili solo nell’app per la scrivania; il salvaschermo conserva la palette scelta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Música e capas só estão disponíveis na aplicação de secretária; a proteção de ecrã mantém a paleta escolhida."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La música i les portades només estan disponibles a l’app d’escriptori; l’estalvi de pantalla conserva la teva paleta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Muziek en hoezen werken alleen in de bureaubladapp; de schermbeveiliging behoudt je gekozen palet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Музыка и обложки доступны только в приложении рабочего стола; заставка сохраняет выбранную палитру."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Музика й обкладинки доступні лише в програмі робочого столу; заставка зберігає вибрану палітру."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽とアートワークはデスクトップアプリのみで利用できます。スクリーンセーバでは選択したパレットを保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악과 아트워크는 데스크탑 앱에서만 사용할 수 있습니다. 화면 보호기는 선택한 팔레트를 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐和封面功能仅限桌面 App；屏幕保护程序保留你选择的调色板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂和封面功能僅限桌面 App；螢幕保護程式保留你選擇的調色板。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموسيقى والأغلفة متاحة في تطبيق سطح المكتب فقط؛ وتحتفظ شاشة التوقف بلوحة الألوان المختارة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוזיקה ועטיפות זמינות רק ביישום שולחן העבודה; שומר המסך שומר על לוח הצבעים שבחרת."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzyka i okładki działają tylko w aplikacji biurkowej; wygaszacz zachowuje wybraną paletę."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müzik ve kapaklar yalnızca masaüstü uygulamasında kullanılabilir; ekran koruyucu seçtiğiniz paleti korur."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik och omslag är bara tillgängliga i skrivbordsappen; skärmsläckaren behåller din valda palett."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत और कवर केवल डेस्कटॉप ऐप में उपलब्ध हैं; स्क्रीन सेवर चुना हुआ पैलेट रखता है।"
          }
        }
      }
    },
