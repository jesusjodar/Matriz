    "Low Power Mode automatically saves energy. Reduce Motion keeps the background still.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Power Mode automatically saves energy. Reduce Motion keeps the background still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de bajo consumo ahorra energía automáticamente. Reducir movimiento deja el fondo quieto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode économie d’énergie réduit automatiquement la consommation. Réduire les animations fige le fond."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stromsparmodus spart automatisch Energie. Bewegung reduzieren hält den Hintergrund an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risparmio energetico riduce automaticamente i consumi. Riduci movimento mantiene fermo lo sfondo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de baixo consumo poupa energia automaticamente. Reduzir movimento mantém o fundo parado."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El mode de baix consum estalvia energia automàticament. Reduir el moviment deixa el fons quiet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De energiebesparingsmodus bespaart automatisch energie. Verminder beweging zet de achtergrond stil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим энергосбережения автоматически снижает расход энергии. Уменьшение движения останавливает фон."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим низького енергоспоживання автоматично заощаджує енергію. Зменшення руху зупиняє фон."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低電力モードでは自動で省エネルギーになります。「視差効果を減らす」では背景を静止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저전력 모드는 자동으로 에너지를 절약합니다. 동작 줄이기를 사용하면 배경이 멈춥니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低电量模式会自动节能。“减弱动态效果”会让背景保持静止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低耗電模式會自動節能。“減弱動態效果”會讓背景保持靜止。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوفر نمط الطاقة المنخفضة الطاقة تلقائيًا. يجعل تقليل الحركة الخلفية ثابتة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב צריכת חשמל נמוכה חוסך אנרגיה אוטומטית. צמצום תנועה מקפיא את הרקע."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb niskiego zużycia energii oszczędza automatycznie. Ograniczenie ruchu zatrzymuje tło."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük Güç Modu otomatik enerji tasarrufu sağlar. Hareketi Azalt arka planı sabit tutar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Strömsparläge sparar energi automatiskt. Minska rörelse håller bakgrunden stilla."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम पावर मोड अपने आप ऊर्जा बचाता है। गति कम करें पृष्ठभूमि को स्थिर रखता है।"
          }
        }
      }
