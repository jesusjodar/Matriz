          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在螢幕保護程式運行時保護 Mac。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احمِ Mac أثناء تشغيل شاشة التوقف."
