    "Emphasize the shared relief of waves and particles.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emphasize the shared relief of waves and particles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca el relieve que comparten las ondas y las partículas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accentuez le relief commun des vagues et des particules."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstärke das gemeinsame Relief von Wellen und Partikeln."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accentua il rilievo condiviso da onde e particelle."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acentue o relevo partilhado pelas ondas e partículas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ressalta el relleu que comparteixen les ones i les partícules."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Benadruk het gedeelde reliëf van golven en deeltjes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подчеркните общий рельеф волн и частиц."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підкресліть спільний рельєф хвиль і частинок."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "波と粒子に共通する立体感を強調します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파도와 입자가 공유하는 입체감을 강조합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "突出波浪与粒子共有的立体感。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "突出波浪與粒子共有的立體感。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبرز التضاريس المشتركة بين الموجات والجسيمات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדגשת התבליט המשותף לגלים ולחלקיקים."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podkreśl wspólny relief fal i cząsteczek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalgaların ve parçacıkların ortak kabartısını vurgulayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Framhäv vågornas och partiklarnas gemensamma relief."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तरंगों और कणों के साझा उभार को बढ़ाएँ।"
          }
        }
      }
    },
    "Energy saving runs at 30 FPS. The other modes run at 60 FPS with different resolutions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy saving runs at 30 FPS. The other modes run at 60 FPS with different resolutions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ahorro de energía usa 30 FPS. Los demás modos usan 60 FPS con distintas resoluciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Économie : 30 FPS. Les autres modes : 60 FPS, avec des résolutions différentes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Energiesparen nutzt 30 FPS. Die anderen Modi nutzen 60 FPS bei unterschiedlicher Auflösung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risparmio energetico: 30 FPS. Gli altri modi: 60 FPS, a risoluzioni diverse."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A poupança usa 30 FPS. Os outros modos usam 60 FPS com resoluções diferentes."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’estalvi d’energia usa 30 FPS. Els altres modes usen 60 FPS amb resolucions diferents."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Energiebesparing gebruikt 30 FPS. Andere modi gebruiken 60 FPS met verschillende resoluties."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экономия: 30 FPS. Другие режимы: 60 FPS с разным разрешением."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Економія використовує 30 FPS. Інші режими — 60 FPS із різною роздільністю."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "省エネルギーは30 FPSです。他のモードは異なる解像度で60 FPSです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절약 모드는 30 FPS입니다. 다른 모드는 서로 다른 해상도에서 60 FPS입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节能模式为 30 FPS。其他模式以不同分辨率运行于 60 FPS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "節能模式為 30 FPS。其他模式以不同解析度運行於 60 FPS。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توفير الطاقة: 30 إطارًا/ث. الأوضاع الأخرى: 60 إطارًا/ث بدقات مختلفة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיסכון באנרגיה: 30 FPS. המצבים האחרים: 60 FPS ברזולוציות שונות."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszczędzanie: 30 FPS. Pozostałe tryby: 60 FPS przy różnych rozdzielczościach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enerji tasarrufu 30 FPS kullanır. Diğer modlar farklı çözünürlüklerde 60 FPS kullanır."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Energisparläge använder 30 FPS. Övriga lägen använder 60 FPS med olika upplösningar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊर्जा बचत मोड 30 FPS पर चलता है। अन्य मोड अलग रिज़ॉल्यूशन पर 60 FPS इस्तेमाल करते हैं।"
          }
        }
      }
    },
    "Enlarge or shrink the moving volumes of color.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlarge or shrink the moving volumes of color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agranda o reduce los volúmenes de color en movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrandissez ou réduisez les volumes colorés en mouvement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrößere oder verkleinere die bewegten Farbvolumen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrandisci o riduci i volumi di colore in movimento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumente ou reduza os volumes de cor em movimento."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplia o redueix els volums de color en moviment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergroot of verklein de bewegende kleurvolumes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличивайте или уменьшайте движущиеся цветовые объёмы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збільшуйте або зменшуйте рухомі кольорові об’єми."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動く色のボリュームを拡大・縮小します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "움직이는 색상 덩어리를 확대하거나 축소합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大或缩小流动的色彩体积。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大或縮小流動的色彩體積。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كبّر أو صغّر كتل الألوان المتحركة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדלה או הקטנה של נפחי הצבע הנעים."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiększ lub pomniejsz ruchome bryły koloru."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketli renk hacimlerini büyütün veya küçültün."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förstora eller förminska färgvolymerna i rörelse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रंगों के गतिशील आयतन को बड़ा या छोटा करें।"
          }
        }
      }
    },
    "Enlarge the orb or its central opening, even beyond the screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlarge the orb or its central opening, even beyond the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplía el orbe o su hueco central, incluso más allá de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrandissez l’orbe ou son ouverture, même au-delà de l’écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrößere die Kugel oder ihre Öffnung über den Bildschirm hinaus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrandisci la sfera o l’apertura centrale, anche oltre lo schermo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplie o orbe ou a abertura central, mesmo além do ecrã."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplia l’orbe o el seu buit central, fins i tot més enllà de la pantalla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergroot de bol of de centrale opening, zelfs voorbij het scherm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличивайте сферу или отверстие даже за пределы экрана."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збільшуйте сферу або отвір навіть за межі екрана."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "球体や中央の穴を、画面より大きく広げることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구체나 중앙 구멍을 화면 너머까지 확대할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大球体或中央空洞，甚至超出屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大球體或中央空洞，甚至超出螢幕。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كبّر الكرة أو فتحتها المركزية، حتى تتجاوز الشاشة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדלת הכדור או הפתח המרכזי, גם מעבר למסך."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiększ kulę lub jej otwór, nawet poza ekran."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küreyi veya orta boşluğu ekranın ötesine kadar büyütün."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förstora klotet eller dess öppning, även utanför skärmen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गोले या उसके बीच के छेद को स्क्रीन से भी बड़ा करें।"
          }
        }
      }
    },
    "Every composition keeps soft, moving edges.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every composition keeps soft, moving edges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las composiciones mantienen bordes suaves y en movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les compositions gardent des contours doux et mobiles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Kompositionen behalten weiche, bewegte Ränder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni composizione mantiene bordi morbidi e in movimento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as composições mantêm contornos suaves e móveis."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Totes les composicions mantenen vores suaus i en moviment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle composities houden zachte, bewegende randen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все композиции сохраняют мягкие подвижные края."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі композиції зберігають м’які рухомі краї."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの構成でも、輪郭が柔らかく動き続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 구성은 부드럽게 움직이는 가장자리를 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有构图都保留柔和、流动的边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有構圖都保留柔和、流動的邊緣。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحافظ جميع التكوينات على حواف ناعمة ومتحركة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל המבנים שומרים על קצוות רכים ונעים."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda kompozycja zachowuje miękkie, ruchome krawędzie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm düzenler yumuşak ve hareketli kenarları korur."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla kompositioner behåller mjuka kanter i rörelse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर रचना के किनारे मुलायम और गतिशील रहते हैं।"
          }
        }
      }
