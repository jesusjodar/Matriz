        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надайте хвилям спокійного або жвавішого ритму."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "波のリズムを穏やかにも活発にもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파도에 차분하거나 활기찬 리듬을 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让波浪拥有平静或更活跃的节奏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓波浪擁有平靜或更活躍的節奏。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح الموجات إيقاعًا هادئًا أو أكثر حيوية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הענקת קצב רגוע או חי יותר לגלים."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaj falom spokojny lub żywszy rytm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalgalara sakin veya daha canlı bir ritim verin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge vågorna en lugn eller livligare rytm."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तरंगों को शांत या अधिक जीवंत लय दें।"
          }
        }
      }
    },
