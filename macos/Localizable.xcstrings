    "Let each sound fade more gradually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let each sound fade more gradually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que cada sonido se desvanezca más despacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez chaque son s’estomper plus progressivement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass jeden Klang langsamer ausklingen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia sfumare ogni suono più gradualmente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe cada som desaparecer mais gradualmente."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes que cada so s’esvaeixi més a poc a poc."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat ieder geluid geleidelijker uitdoven."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть каждый звук затухает плавнее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нехай кожен звук згасає плавніше."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音への反応をゆっくり減衰させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 소리에 대한 반응을 더 서서히 줄입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让每次声音响应更缓慢地消退。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓每次聲音響應更緩慢地消退。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل تأثير كل صوت يتلاشى تدريجيًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דעיכה הדרגתית יותר של כל צליל."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niech każdy dźwięk wygasa bardziej stopniowo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sesin etkisinin daha yavaş sönmesini sağlayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt varje ljud klinga av mer gradvis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर आवाज़ की प्रतिक्रिया को अधिक धीरे समाप्त होने दें।"
          }
        }
      }
    },
    "Let music shape the light and bring in album colors.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let music shape the light and bring in album colors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que la música dé forma a la luz y aporte los colores de las portadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez la musique animer la lumière et les couleurs des pochettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Musik das Licht und die Coverfarben gestalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che la musica modelli la luce e i colori delle copertine."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe a música moldar a luz e trazer as cores das capas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa que la música doni forma a la llum i aporti colors de portada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat muziek het licht en de hoeskleuren vormgeven."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть музыка управляет светом и цветами обложек."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нехай музика керує світлом і кольорами обкладинок."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽で光を動かし、アートワークの色を取り込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악으로 빛을 움직이고 앨범의 색을 가져옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让音乐塑造光影，并带来封面的色彩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓音樂塑造光影，並帶來封面的色彩。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دع الموسيقى تشكّل الضوء وتجلب ألوان الأغلفة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המוזיקה מעצבת את האור ומוסיפה צבעי עטיפה."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól muzyce kształtować światło i kolory okładek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müzik ışığı şekillendirsin ve kapak renklerini getirsin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt musik forma ljuset och ge färger från omslagen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत को रोशनी बदलने और कवर के रंग लाने दें।"
          }
        }
      }
    },
    "Lighten or darken the whole background.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lighten or darken the whole background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aclara u oscurece todo el fondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclaircissez ou assombrissez l’ensemble du fond."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helle den gesamten Hintergrund auf oder dunkle ihn ab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiarisci o scurisci l’intero sfondo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clareie ou escureça todo o fundo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aclareix o enfosqueix tot el fons."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak de hele achtergrond lichter of donkerder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте весь фон светлее или темнее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Освітліть або затемніть увесь фон."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景全体を明るく、または暗くします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경 전체를 밝게 하거나 어둡게 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调亮或调暗整个背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調亮或調暗整個背景。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل الخلفية كلها أفتح أو أغمق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבהרה או הכהיה של הרקע כולו."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozjaśnij lub przyciemnij całe tło."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm arka planı aydınlatın veya karartın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör hela bakgrunden ljusare eller mörkare."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी पृष्ठभूमि को हल्का या गहरा करें।"
          }
        }
      }
    },
