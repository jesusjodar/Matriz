    "macOS manages the password screen and sign-in separately from the animated screensaver.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS manages the password screen and sign-in separately from the animated screensaver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS gestiona la pantalla de contraseña y el inicio de sesión por separado del salvapantallas animado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS gère l’écran de mot de passe et la connexion séparément de l’économiseur animé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS verwaltet Passwortbildschirm und Anmeldung getrennt vom animierten Bildschirmschoner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS gestisce la schermata della password e l’accesso separatamente dal salvaschermo animato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS gere o ecrã da palavra-passe e o início de sessão separadamente da proteção de ecrã animada."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El macOS gestiona la pantalla de contrasenya i l’inici de sessió per separat de l’estalvi de pantalla animat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS beheert het wachtwoordscherm en inloggen los van de bewegende schermbeveiliging."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS управляет экраном пароля и входом отдельно от анимированной заставки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS керує екраном пароля й входом окремо від анімованої заставки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワード画面とログインは、動くスクリーンセーバとは別にmacOSが管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호 화면과 로그인은 움직이는 화면 보호기와 별개로 macOS가 관리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 单独管理密码界面和登录，与动态屏幕保护程序分开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 單獨管理密碼界面和登錄，與動態螢幕保護程式分開。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدير macOS شاشة كلمة السر وتسجيل الدخول بشكل منفصل عن شاشة التوقف المتحركة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS מנהלת את מסך הסיסמה וההתחברות בנפרד משומר המסך המונפש."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zarządza ekranem hasła i logowaniem oddzielnie od animowanego wygaszacza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS parola ekranını ve oturum açmayı hareketli ekran koruyucudan ayrı yönetir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hanterar lösenordsskärm och inloggning separat från den animerade skärmsläckaren."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS पासवर्ड स्क्रीन और साइन-इन को गतिशील स्क्रीन सेवर से अलग सँभालता है।"
          }
        }
      }
    },
