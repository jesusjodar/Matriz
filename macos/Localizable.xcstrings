    "Activate audio to start listening.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activate audio to start listening."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el audio para empezar el análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’audio pour lancer l’analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Audio, um die Analyse zu starten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l’audio per avviare l’analisi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o áudio para iniciar a análise."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa l’àudio per iniciar l’anàlisi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Activeer audio om de analyse te starten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите звук, чтобы начать анализ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть аудіо, щоб почати аналіз."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオを有効にして解析を開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석을 시작하려면 오디오를 활성화하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用音频以开始分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啓用音頻以開始分析。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الصوت لبدء التحليل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להפעיל את השמע כדי להתחיל בניתוח."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz dźwięk, aby rozpocząć analizę."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizi başlatmak için sesi etkinleştirin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera ljud för att starta analysen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्लेषण शुरू करने के लिए ऑडियो सक्रिय करें।"
          }
        }
      }
    },
