          "stringUnit": {
            "state": "translated",
            "value": "Bescherm je Mac terwijl de schermbeveiliging draait."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитите Mac во время работы заставки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захищайте Mac під час роботи екранної заставки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンセーバの使用中もMacを保護しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 보호기가 실행되는 동안 Mac을 보호하세요."
