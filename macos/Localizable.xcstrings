{
  "sourceLanguage": "en",
  "strings": {
    "100% preserves the extracted colors; zero makes them grayscale.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100% preserves the extracted colors; zero makes them grayscale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al 100 % conserva los colores extraídos; a cero los vuelve grises."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % préserve les couleurs extraites ; zéro les rend grises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % bewahrt die erkannten Farben; null macht sie grau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il 100% conserva i colori estratti; zero li rende grigi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "100% preserva as cores extraídas; zero torna-as cinzentas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Al 100 % conserva els colors extrets; a zero els torna grisos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "100% behoudt de gevonden kleuren; nul maakt ze grijs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "100% сохраняет исходные цвета; ноль делает их серыми."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "100% зберігає виділені кольори; нуль робить їх сірими."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100%で抽出した色を保ち、0でグレースケールになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100%는 추출한 색을 유지하고, 0은 회색으로 만듭니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 保留提取的颜色；设为零则变为灰色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 保留提取的顏色；設為零則變為灰色。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحافظ نسبة 100% على الألوان المستخرجة؛ ويحولها الصفر إلى الرمادي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "100% שומר על הצבעים שחולצו; אפס הופך אותם לאפור."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "100% zachowuje wyodrębnione kolory; zero zmienia je w szarość."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%100 çıkarılan renkleri korur; sıfır onları gri yapar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % behåller de hämtade färgerna; noll gör dem grå."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "100% निकाले गए रंगों को बनाए रखता है; शून्य उन्हें धूसर कर देता है।"
          }
        }
      }
    },
    "3D artist, developer and technology enthusiast.": {
