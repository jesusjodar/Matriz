    "This restores the original appearance, motion and music settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This restores the original appearance, motion and music settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recuperarán los ajustes originales de apariencia, movimiento y música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages d’apparence, de mouvement et de musique d’origine seront restaurés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprünglichen Einstellungen für Aussehen, Bewegung und Musik werden wiederhergestellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Saranno ripristinate le impostazioni originali di aspetto, movimento e musica."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serão repostas as definições originais de aparência, movimento e música."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es recuperaran els valors originals d’aparença, moviment i música."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De oorspronkelijke instellingen voor weergave, beweging en muziek worden hersteld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут восстановлены исходные настройки вида, движения и музыки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буде відновлено початкові параметри вигляду, руху й музики."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観、動き、音楽の設定を初期値に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모양, 움직임, 음악 설정을 초기값으로 복원합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将恢复原来的外观、动态和音乐设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將恢復原來的外觀、動態和音樂設定。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُستعاد إعدادات المظهر والحركة والموسيقى الأصلية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרות המראה, התנועה והמוזיקה המקוריות ישוחזרו."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaną przywrócone oryginalne ustawienia wyglądu, ruchu i muzyki."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüm, hareket ve müzik ayarları özgün değerlerine döner."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De ursprungliga inställningarna för utseende, rörelse och musik återställs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिखावट, गति और संगीत की मूल सेटिंग्ज़ वापस आ जाएँगी।"
          }
        }
      }
    },
