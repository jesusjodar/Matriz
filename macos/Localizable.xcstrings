    "How strongly music changes depth, light and pace.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How strongly music changes depth, light and pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto cambian la profundidad, la luz y el ritmo con la música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Influence de la musique sur profondeur, lumière et rythme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark Musik Tiefe, Licht und Tempo beeinflusst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto la musica modifica profondità, luce e ritmo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto a música altera a profundidade, luz e ritmo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quant canvien la profunditat, la llum i el ritme amb la música."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe sterk muziek diepte, licht en tempo beïnvloedt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько музыка меняет глубину, свет и ритм."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки музика змінює глибину, світло й ритм."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽が奥行き、光、リズムを変化させる強さです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악이 깊이, 빛, 속도를 바꾸는 강도입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐改变深度、光线和节奏的强度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂改變深度、光線和節奏的強度。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوة تأثير الموسيقى في العمق والضوء والإيقاع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוצמת השפעת המוזיקה על העומק, האור והקצב."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siła wpływu muzyki na głębię, światło i rytm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müziğin derinliği, ışığı ve ritmi değiştirme gücü."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur starkt musik ändrar djup, ljus och tempo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत गहराई, रोशनी और लय को कितना बदलता है।"
          }
        }
      }
    },
