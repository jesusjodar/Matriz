    "Keep your Mac protected while the screensaver is running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your Mac protected while the screensaver is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el Mac protegido mientras funciona el salvapantallas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protégez le Mac pendant l’économiseur d’écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schütze deinen Mac, während der Bildschirmschoner läuft."
          }
