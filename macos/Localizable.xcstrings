    "Blend one main tone or the full palette.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blend one main tone or the full palette."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezcla un tono principal o toda la paleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mélangez une teinte principale ou toute la palette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mische einen Hauptton oder die gesamte Palette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mescola un tono principale o tutta la palette."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Misture um tom principal ou toda a paleta."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Barreja un to principal o tota la paleta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meng één hoofdtoon of het hele palet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смешивайте основной оттенок или всю палитру."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змішуйте основний відтінок або всю палітру."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主となる1色からパレット全体まで混ぜ合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주요 색조 하나 또는 전체 팔레트를 섞습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "混合一种主色调或整个调色板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "混合一種主色調或整個調色板。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امزج لونًا رئيسيًا واحدًا أو لوحة الألوان كاملة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ערבוב גוון ראשי אחד או כל לוח הצבעים."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mieszaj główny odcień lub całą paletę."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir ana tonu veya tüm paleti karıştırın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanda en huvudton eller hela paletten."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक मुख्य रंग या पूरे पैलेट को मिलाएँ।"
          }
        }
      }
    },
