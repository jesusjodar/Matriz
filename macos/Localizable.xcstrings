    "Move from grayscale to vivid color, including album palettes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move from grayscale to vivid color, including album palettes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa de los grises a colores vivos, también con las paletas de portada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gris aux couleurs vives, pochettes comprises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Graustufen zu kräftigen Farben, auch bei Coverpaletten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal grigio ai colori vivaci, anche per le copertine."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Do cinzento a cores vivas, incluindo as paletas das capas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa dels grisos a colors vius, també amb les paletes de portada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van grijstinten naar levendige kleuren, ook voor albumhoezen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От серых оттенков к ярким цветам, включая обложки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Від сірих відтінків до яскравих кольорів, включно з обкладинками."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グレースケールから鮮やかな色まで調整します。アートワークにも適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회색부터 생생한 색상까지 조절합니다. 앨범 팔레트에도 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从灰度到鲜艳色彩，专辑调色板也同样适用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從灰度到鮮艷色彩，專輯調色板也同樣適用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من الرمادي إلى ألوان زاهية، بما فيها ألوان الأغلفة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאפור לצבעים חיים, כולל לוחות צבעי אלבומים."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od szarości po żywe kolory, także w paletach okładek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Albüm paletleri dâhil, griden canlı renklere geçin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från gråskala till livliga färger, även för albumpaletter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धूसर से जीवंत रंगों तक, ऐल्बम पैलेट सहित।"
          }
        }
      }
    },
    "Move particles with the waves. Above 100% uses more graphics power.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move particles with the waves. Above 100% uses more graphics power."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve las partículas con las ondas. Por encima del 100 % requiere más potencia gráfica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez les particules avec les vagues. Au-delà de 100 %, le calcul graphique augmente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege Partikel mit den Wellen. Über 100 % steigt der Grafikaufwand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muovi le particelle con le onde. Oltre il 100% aumenta il carico grafico."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova as partículas com as ondas. Acima de 100% aumenta o processamento gráfico."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mou les partícules amb les ones. Per sobre del 100 % requereix més potència gràfica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweeg de deeltjes met de golven. Boven 100% is meer grafische rekenkracht nodig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигайте частицы вместе с волнами. Свыше 100% требуется больше ресурсов графики."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рухайте частинки разом із хвилями. Понад 100% потрібно більше графічних ресурсів."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "波に合わせて粒子を動かします。100%を超えるとグラフィックス負荷が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파도에 따라 입자를 움직입니다. 100%를 넘으면 그래픽 사용량이 늘어납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让粒子随波浪移动。超过 100% 会增加图形计算负担。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓粒子隨波浪移動。超過 100% 會增加圖形計算負擔。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّك الجسيمات مع الموجات. تتطلب القيم فوق 100% قدرة رسومية أكبر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזזת חלקיקים עם הגלים. מעל 100% נדרש יותר עיבוד גרפי."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poruszaj cząsteczki z falami. Powyżej 100% potrzeba więcej mocy graficznej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parçacıkları dalgalarla hareket ettirin. %100 üzeri daha fazla grafik gücü kullanır."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta partiklar med vågorna. Över 100 % kräver mer grafikkraft."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कणों को तरंगों के साथ चलाएँ। 100% से अधिक पर ग्राफ़िक्स का उपयोग बढ़ता है।"
          }
        }
      }
    },
