    "Move the wave boundary up or down in the lower, upper and central compositions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the wave boundary up or down in the lower, upper and central compositions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube o baja el borde de la onda en las composiciones inferior, superior y central."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte ou descendez le bord de la vague dans les compositions inférieure, supérieure et centrale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebe die Wellenkante in der unteren, oberen und zentralen Komposition nach oben oder unten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta il bordo dell'onda verso l'alto o verso il basso nelle composizioni inferiore, superiore e centrale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova a borda da onda para cima ou para baixo nas composições inferior, superior e central."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Puja o baixa la vora de l'ona en les composicions inferior, superior i central."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats de golfrand omhoog of omlaag in de onderste, bovenste en centrale composities."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сдвигайте границу волны вверх или вниз в нижней, верхней и центральной композициях."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зсувайте межу хвилі вгору або вниз у нижній, верхній і центральній композиціях."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部、上部、中央の構図で波の境界を上下に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단, 상단 및 중앙 구도에서 파도 경계를 위아래로 이동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在底部、顶部和中央构图中上下移动波浪边界。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在底部、頂部和中央構圖中上下移動波浪邊界。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّك حد الموجة لأعلى أو لأسفل في التكوينات السفلية والعلوية والمركزية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזז את גבול הגל למעלה או למטה בהרכבים התחתון, העליון והמרכזי."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuwaj granicę fali w górę lub w dół w kompozycjach dolnej, górnej i środkowej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, üst ve orta kompozisyonlarda dalga sınırını yukarı veya aşağı taşıyın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta vågkanten uppåt eller nedåt i de nedre, övre och centrala kompositionerna."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निचली, ऊपरी और केंद्रीय रचनाओं में लहर की सीमा को ऊपर या नीचे ले जाएँ।"
          }
        }
      }
    },
