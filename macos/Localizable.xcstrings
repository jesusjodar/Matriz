    "Make quiet music more responsive without changing its volume.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make quiet music more responsive without changing its volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta la respuesta a música suave sin cambiar su volumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplifiez la réaction aux musiques douces sans modifier leur volume."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstärke die Reaktion auf leise Musik, ohne ihre Lautstärke zu ändern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta la risposta alla musica lieve senza cambiarne il volume."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumente a reação à música suave sem alterar o volume."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmenta la resposta a música suau sense canviar-ne el volum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versterk de reactie op zachte muziek zonder het volume te wijzigen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Усильте реакцию на тихую музыку, не меняя громкость."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посильте реакцію на тиху музику, не змінюючи гучність."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音量を変えずに、静かな音楽への反応を強めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음량을 바꾸지 않고 잔잔한 음악에 대한 반응을 높입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强对轻柔音乐的响应，不改变音量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強對輕柔音樂的響應，不改變音量。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عزّز الاستجابة للموسيقى الهادئة دون تغيير مستوى صوتها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגברת התגובה למוזיקה שקטה בלי לשנות את עוצמתה."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzmocnij reakcję na cichą muzykę bez zmiany głośności."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses düzeyini değiştirmeden hafif müziğe tepkiyi artırın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öka reaktionen på lågmäld musik utan att ändra volymen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ का स्तर बदले बिना हल्के संगीत पर प्रतिक्रिया बढ़ाएँ।"
          }
        }
      }
    },
    "Make the final highlights and shadows more distinct.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the final highlights and shadows more distinct."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diferencia más las luces y las sombras del color final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distinguez davantage les lumières et ombres finales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebe die endgültigen Lichter und Schatten stärker hervor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distingui maggiormente luci e ombre del colore finale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Distinga melhor as luzes e sombras da cor final."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Diferencia més les llums i les ombres del color final."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak de uiteindelijke lichte en donkere tinten duidelijker."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильнее выделите светлые и тёмные участки итогового цвета."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чіткіше розділіть світлі й темні ділянки кінцевого кольору."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終的な色の明暗をはっきりさせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최종 색상의 밝은 부분과 어두운 부분을 구분합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更清晰地区分最终颜色的明暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更清晰地區分最終顏色的明暗。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل الأجزاء المضيئة والمظلمة من اللون النهائي أكثر تميزًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרדה ברורה יותר בין האזורים הבהירים והכהים בצבע הסופי."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mocniej odróżnij jasne i ciemne obszary końcowego koloru."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son rengin aydınlık ve karanlık alanlarını belirginleştirin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör den färdiga färgens ljusa och mörka partier tydligare."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतिम रंग के उजले और गहरे भागों को अधिक स्पष्ट करें।"
          }
        }
      }
    },
