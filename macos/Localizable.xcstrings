        }
      }
    },
    "Balance smoothness, sharpness and energy use.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance smoothness, sharpness and energy use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibra la fluidez, la nitidez y el consumo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équilibrez fluidité, netteté et consommation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimme Flüssigkeit, Schärfe und Energieverbrauch ab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilancia fluidità, nitidezza e consumo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibre fluidez, nitidez e consumo de energia."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibra fluïdesa, nitidesa i consum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breng vloeiendheid, scherpte en energiegebruik in balans."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс плавности, чёткости и энергопотребления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збалансуйте плавність, чіткість та енергоспоживання."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "滑らかさ、鮮明さ、消費電力のバランスを調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러움, 선명도, 에너지 사용의 균형을 조절하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡流畅度、清晰度与能耗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡流暢度、清晰度與能耗。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وازن بين السلاسة والوضوح واستهلاك الطاقة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איזון בין חלקות, חדות וצריכת אנרגיה."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrównoważ płynność, ostrość i zużycie energii."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akıcılık, keskinlik ve enerji kullanımını dengeleyin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Balansera följsamhet, skärpa och energianvändning."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहजता, स्पष्टता और ऊर्जा उपयोग का संतुलन बनाएँ।"
          }
        }
      }
    },
