    "At zero, size stays constant. Increase it for larger particles in bright areas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At zero, size stays constant. Increase it for larger particles in bright areas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A cero, el tamaño se mantiene. Auméntalo para que las partículas crezcan en las zonas luminosas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À zéro, la taille reste fixe. Augmentez pour agrandir les particules dans les zones claires."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei null bleibt die Größe gleich. Höhere Werte vergrößern Partikel in hellen Bereichen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A zero, la dimensione resta fissa. Aumenta per ingrandire le particelle nelle zone luminose."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A zero, o tamanho mantém-se. Aumente para ter partículas maiores nas áreas luminosas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A zero, la mida es manté. Augmenta-ho perquè les partícules creixin a les zones lluminoses."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij nul blijft de grootte gelijk. Verhoog voor grotere deeltjes in lichte gebieden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При нуле размер постоянный. Увеличьте значение, чтобы частицы росли в светлых областях."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За нульового значення розмір сталий. Збільште його для більших частинок у світлих зонах."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0ではサイズが一定です。値を上げると明るい領域の粒子が大きくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0에서는 크기가 일정합니다. 값을 높이면 밝은 영역의 입자가 커집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为零时大小固定。提高此值可让亮处的粒子更大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設為零時大小固定。提高此值可讓亮處的粒子更大。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الصفر يبقى الحجم ثابتًا. ارفع القيمة لتكبير الجسيمات في المناطق المضيئة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באפס הגודל קבוע. ערך גבוה מגדיל חלקיקים באזורים בהירים."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy zerze rozmiar jest stały. Zwiększ wartość, aby cząsteczki rosły w jasnych obszarach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfırda boyut sabittir. Aydınlık alanlarda daha büyük parçacıklar için artırın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid noll är storleken fast. Öka värdet för större partiklar i ljusa områden."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शून्य पर आकार स्थिर रहता है। चमकीले हिस्सों में बड़े कणों के लिए मान बढ़ाएँ।"
          }
        }
      }
    },
    "Audio is never recorded or sent anywhere. Analysis stops while paused, asleep, locked or using Reduce Motion.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is never recorded or sent anywhere. Analysis stops while paused, asleep, locked or using Reduce Motion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio no se graba ni se envía. El análisis se detiene al pausar, dormir o bloquear el Mac, y con Reducir movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio n’est ni enregistré ni envoyé. L’analyse s’arrête en pause, en veille, au verrouillage ou avec Réduire les animations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird weder aufgenommen noch gesendet. Die Analyse stoppt bei Pause, Ruhezustand, Sperre oder Bewegung reduzieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio non viene registrato né inviato. L’analisi si ferma in pausa, in stop, al blocco o con Riduci movimento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio não é gravado nem enviado. A análise para em pausa, em repouso, ao bloquear ou com Reduzir movimento."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’àudio no es grava ni s’envia. L’anàlisi s’atura en pausar, dormir o bloquejar el Mac, i amb Reduir el moviment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wordt niet opgenomen of verzonden. Analyse stopt bij pauze, sluimerstand, vergrendeling of Verminder beweging."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук не записывается и не отправляется. Анализ останавливается при паузе, сне, блокировке и уменьшении движения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук не записується й не надсилається. Аналіз зупиняється під час паузи, сну, блокування або зменшення руху."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は録音・送信されません。一時停止、スリープ、ロック中や「視差効果を減らす」使用時は解析を停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오는 녹음되거나 전송되지 않습니다. 일시 정지, 잠자기, 잠금 또는 동작 줄이기 사용 중에는 분석이 멈춥니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频不会被录制或发送。暂停、睡眠、锁定或启用“减弱动态效果”时停止分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音頻不會被錄制或發送。暫停、睡眠、鎖定或啓用“減弱動態效果”時停止分析。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُسجل الصوت ولا يُرسل. يتوقف التحليل عند الإيقاف المؤقت أو السكون أو القفل أو تفعيل تقليل الحركة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השמע אינו מוקלט או נשלח. הניתוח נעצר בהשהיה, שינה, נעילה או בעת שימוש בצמצום תנועה."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk nie jest nagrywany ani wysyłany. Analiza zatrzymuje się podczas pauzy, uśpienia, blokady lub ograniczenia ruchu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses kaydedilmez veya gönderilmez. Duraklatma, uyku, kilit veya Hareketi Azalt sırasında analiz durur."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljud spelas inte in eller skickas. Analysen stannar vid paus, vila, låsning eller Minska rörelse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो रिकॉर्ड या भेजा नहीं जाता। विराम, स्लीप, लॉक या गति कम करें चालू होने पर विश्लेषण रुक जाता है।"
          }
        }
      }
    },
